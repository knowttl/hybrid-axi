{
  "name": "@knowttl/hybrid-axi",
  "version": "0.1.0",
  "description": "Investigate Hybrid Analysis with bounded reads and explicitly guarded writes",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hybrid-axi": "bin/hybrid-axi.js",
    "hybrid-axi-hook": "bin/hybrid-axi-hook.js"
  },
  "exports": {
    "./catalogue": "./dist/src/catalogue.js",
    "./inventory": "./inventory/capabilities.json",
    "./axi-credential.schema.json": "./axi-credential.schema.json"
  },
  "files": [
    "bin",
    "dist/src",
    "inventory/capabilities.json",
    "axi-credential.schema.json",
    "docs/commands.md",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowttl/hybrid-axi.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm run typecheck",
    "test": "node scripts/isolated.mjs node scripts/test-changes.mjs",
    "docs:generate": "node --import=./test/support/deny-network.mjs scripts/generate-docs.mjs",
    "docs:check": "node --import=./test/support/deny-network.mjs scripts/generate-docs.mjs --check",
    "spec:generate": "node --import=./test/support/deny-network.mjs scripts/specs.mjs --generate",
    "spec:check": "node --import=./test/support/deny-network.mjs scripts/specs.mjs --check"
  },
  "dependencies": {
    "@toon-format/toon": "2.3.1",
    "axi-sdk-js": "0.1.13",
    "smol-toml": "1.9.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
