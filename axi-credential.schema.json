{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/knowttl/hybrid-axi/axi-credential.schema.json",
  "title": "Hybrid Analysis AXI credential profile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "origin": { "const": "https://hybrid-analysis.com", "default": "https://hybrid-analysis.com" },
    "apiKey": { "$ref": "#/$defs/secretRef", "x-secret": true, "default": { "env": "HYBRID_AXI_API_KEY" } },
    "writes": {
      "type": "object", "additionalProperties": false, "required": ["allowWrites", "operations"],
      "default": { "allowWrites": false, "operations": [] },
      "properties": {
        "allowWrites": { "type": "boolean" },
        "operations": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" } }
      }
    }
  },
  "$defs": {
    "secretRef": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["env"], "properties": { "env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } } },
        { "type": "object", "additionalProperties": false, "required": ["file"], "properties": { "file": { "type": "string", "pattern": "^(?:/|[A-Za-z]:[\\\\/])" } } }
      ]
    }
  }
}
